{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineLauncher",
  "version": "0.4.2",
  "identifier": "com.example.minelauncher",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MineLauncher",
        "width": 1120,
        "height": 720,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDREM2M0IyMjgyNjBEQTAKUldTZ0RTWW9zbVBjYkdmK2RmUitENlFjNVFvVFRqdUlBU0FUUmJVNHJDWXd2VXlzNCtGblV6UU4K",
      "endpoints": [
        "https://github.com/Xa1ret/MineLauncher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}